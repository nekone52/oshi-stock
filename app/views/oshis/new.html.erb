<%# この画面は本物のフォームなので、押せない設定(inert)を外す %>
<% content_for :interactive, true %>

<div class="mx-auto max-w-[430px] px-4 pb-32">

  <!-- ヘッダー(戻るとタイトル) -->
  <header class="flex items-center gap-1 pt-4 pb-2">
    <%= link_to oshis_path, aria: { label: "戻る" }, class: "flex h-11 w-11 items-center justify-center text-ink" do %>
      <svg class="h-[22px] w-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
    <% end %>
    <h1 class="font-display text-xl font-bold text-ink">推しを追加</h1>
  </header>

  <!-- 推しの登録フォーム(送り先は POST /oshis → oshis#create) -->
  <%# 選んだ色と画像を、その場でプレビューする(oshi_preview_controller.js) %>
  <%= form_with model: @character, url: oshis_path, data: { controller: "oshi-preview" } do |f| %>
    <div class="flex flex-col gap-5">
      <!-- 入力ミスのお知らせ(保存できなかったときだけ出す) -->
      <% if @character.errors.any? %>
        <div role="alert" class="rounded-lg bg-danger-bg px-3 py-2 text-[13px] text-danger">
          <ul class="list-disc space-y-0.5 pl-4">
            <% @character.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- アイコン画像(丸い枠を押すと、画像を選ぶ画面が開く) -->
      <label class="flex cursor-pointer flex-col items-center gap-2 pt-2">
        <div class="flex h-28 w-28 items-center justify-center overflow-hidden rounded-full border-2 border-dashed border-line bg-white text-ink-soft">
          <img data-oshi-preview-target="image" alt="選んだアイコン画像" class="hidden h-full w-full object-cover">
          <svg data-oshi-preview-target="placeholder" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="m20.5 16-5-5-8 8.5"/></svg>
        </div>
        <span class="text-[13px] font-bold text-accent-strong">アイコン画像を追加</span>
        <%= f.file_field :icon, accept: "image/png,image/jpeg,image/webp", data: { action: "oshi-preview#updateImage" }, class: "w-full text-xs text-ink-soft file:mr-2 file:rounded-full file:border-0 file:bg-accent-soft file:px-3 file:py-1 file:text-xs file:font-bold file:text-accent-strong" %>
      </label>

      <!-- 名前(必須) -->
      <div class="flex flex-col gap-1.5">
        <%= f.label :name, class: "text-[13px] font-bold text-ink" do %>
          名前 <span class="text-accent-strong">*</span>
        <% end %>
        <%= f.text_field :name, required: true, maxlength: 50, placeholder: "例：ヒナタ", class: "h-12 w-full rounded-xl border border-line bg-white px-3 text-base text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" %>
      </div>

      <!-- 推しの色(カラーピッカーで自由に選ぶ。選んだ色はグラデーションで見せる) -->
      <div class="flex flex-col gap-1.5">
        <%= f.label :color, "推しの色", class: "text-[13px] font-bold text-ink" %>
        <div class="flex items-center gap-3">
          <%= f.color_field :color, value: @character.color.presence || "#E8577A", data: { oshi_preview_target: "color", action: "input->oshi-preview#updateColor" }, class: "h-12 w-14 shrink-0 cursor-pointer rounded-xl border border-line bg-white p-1" %>
          <!-- 選んだ色のプレビュー -->
          <div data-oshi-preview-target="bar" class="flex h-12 flex-1 items-center justify-end rounded-xl bg-gradient-to-r from-chara-a via-chara-a-soft to-white px-3 font-display text-base font-bold text-ink">推しの名前</div>
        </div>
        <span class="text-xs text-ink-soft">名刺カードやアイコンに、この色のグラデーションがかかります</span>
      </div>
    </div>

    <!-- 下の登録ボタン -->
    <div class="fixed inset-x-0 bottom-0 z-20 mx-auto max-w-[430px] border-t border-line bg-white px-5 pt-3 pb-5">
      <%= f.submit "登録する", class: "w-full cursor-pointer rounded-2xl bg-accent py-3.5 font-display text-base font-bold text-white transition hover:bg-accent-strong active:scale-95" %>
    </div>
  <% end %>
</div>
