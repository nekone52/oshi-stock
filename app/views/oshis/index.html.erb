<%# この画面は本物のデータを表示するので、押せない設定(inert)を外す %>
<% content_for :interactive, true %>

<div class="mx-auto max-w-[430px] px-4 pb-10">

  <!-- ヘッダー(見出しと追加ボタン) -->
  <%# ホームに戻る(下のメニューのかわり) %>
  <%= render "shared/home_link" %>
  <header class="flex items-center justify-between gap-3 pt-1 pb-3">
    <div class="flex flex-col">
      <span class="text-xs font-bold tracking-[0.3em] text-ink-faint">MY OSHI</span>
      <h1 class="bg-gradient-to-r from-accent to-chara-c bg-clip-text font-display text-3xl font-black text-transparent">推しキャラ</h1>
    </div>
    <%= link_to "＋ 推しを追加", new_oshi_path, class: "inline-flex h-11 shrink-0 items-center rounded-full bg-accent px-4 text-sm font-bold text-on-accent transition hover:bg-accent-strong active:scale-95" %>
  </header>

  <% if @characters.any? %>
    <!-- 推しキャラの一覧(名刺のような横長カード。押すと推しの詳細へ) -->
    <ul class="flex flex-col gap-3">
      <% @characters.each do |character| %>
        <% color = character.display_color %>
        <li class="relative">
          <%# カード全体は、上から1/4までを推しの色100%、そこから下へ45%までうすくなるグラデーションでぬり、ふちも推しの色(60%)にする(青と水色の推しも見分けられるように) %>
          <%= link_to oshi_path(character), style: "background-image: linear-gradient(to bottom, #{color} 0%, #{color} 25%, color-mix(in srgb, #{color} 45%, white) 100%); border: 1.5px solid color-mix(in srgb, #{color} 60%, white)", class: "flex aspect-[91/55] overflow-hidden rounded-2xl shadow-sm transition hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 active:scale-[0.98]" do %>
            <!-- 左:推しの画像(画像がないときは、白→推しの色50%のグラデーションと、推しの色の頭文字) -->
            <% if character.icon.attached? %>
              <%= image_tag character.icon.variant(:display), alt: character.name, class: "w-[44%] shrink-0 object-cover" %>
            <% else %>
              <%# 頭文字は推しの色に、こい文字色(#2B1E2A)を20%まぜて、うすい背景でも読めるようにする %>
              <div style="background-image: linear-gradient(to bottom right, white, color-mix(in srgb, <%= color %> 50%, white)); color: color-mix(in srgb, <%= color %> 80%, #2B1E2A)" class="relative flex w-[44%] shrink-0 items-center justify-center font-display text-6xl font-bold">
                <!-- うっすら水玉の模様 -->
                <span class="absolute inset-0 bg-[radial-gradient(rgb(255_255_255/0.22)_1.5px,transparent_1.5px)] bg-[length:14px_14px]" aria-hidden="true"></span>
                <span class="relative"><%= character.name.first %></span>
              </div>
            <% end %>
            <!-- 右:名前・合計・グッズの数 -->
            <div class="flex min-w-0 flex-1 flex-col justify-end gap-3 p-3.5">
              <%# 名前の下の線をなくしたので、名前と合計のあいだは gap-2 であける %>
              <div class="flex flex-col gap-2">
                <%# 名前のうしろを白くぼかして、上の濃い推しの色の上でも読めるようにする %>
                <span style="text-shadow: 0 0 6px white, 0 0 12px white, 0 0 18px rgb(255 255 255 / 0.8)" class="truncate pr-8 font-display text-[28px] leading-tight font-black text-ink"><%= character.name %></span>
                <%# グッズ機能ができるまでは、合計と数は 0 を出す。文字は背景が濃くても読めるように、こい色(text-ink)にする %>
                <span class="inline-flex items-baseline gap-1.5 self-start rounded-full border border-line bg-white/80 px-3 py-1 text-xs text-ink">所持グッズ合計 <span class="text-base font-bold text-ink">¥0</span></span>
              </div>
              <!-- グッズの数(チップ風。合計の丸とおそろいで、白を少し透かす。詳細画面で一覧が見られる) -->
              <div class="grid grid-cols-3 gap-1.5">
                <% [ "ほしい", "予約中", "所持" ].each do |label| %>
                  <span class="flex flex-col items-center rounded-lg border border-line bg-white/80 py-1">
                    <span class="text-xs text-ink-soft"><%= label %></span><span class="text-lg leading-tight font-bold text-ink">0</span>
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
          <%# details は HTML の部品で、summary(…)を押すたびにメニューが開く・閉じる(JavaScript なし) %>
          <!-- 右上:編集・削除のメニュー(…) -->
          <details class="absolute top-2.5 right-2.5">
            <summary aria-label="<%= character.name %>のメニュー" class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-line bg-white text-ink shadow-sm [&::-webkit-details-marker]:hidden">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg>
            </summary>
            <!-- 開いたメニュー(削除は Issue 22 で本物にする。今は削除の確認のモックへ移るだけ) -->
            <div class="absolute top-12 right-0 z-10 flex w-36 flex-col overflow-hidden rounded-xl border border-line bg-white text-sm font-bold shadow-md">
              <%= link_to "編集する", edit_oshi_path(character), class: "px-4 py-3 text-ink hover:bg-accent-soft" %>
              <%= link_to "消去する", confirm_delete_oshi_path(character), class: "border-t border-line px-4 py-3 text-danger hover:bg-danger-bg" %>
            </div>
          </details>
        </li>
      <% end %>
    </ul>
  <% else %>
    <!-- 推しがまだいないとき(追加ボタンへ案内する) -->
    <div class="flex flex-col items-center gap-3 rounded-2xl border border-dashed border-line bg-white px-4 py-10 text-center">
      <p class="font-display text-base font-bold text-ink">まだ推しがいません</p>
      <p class="text-[13px] text-ink-soft">右上の「＋ 推しを追加」から、推しを登録しましょう</p>
    </div>
  <% end %>
</div>
