<%= form_with model: @character, url: url, data: { controller: "oshi-preview" } do |f| %>
  <div class="flex flex-col gap-5">
    <% if @character.errors.any? %>
      <div role="alert" class="rounded-lg bg-danger-bg px-3 py-2 text-[13px] text-danger">
        <ul class="list-disc space-y-0.5 pl-4">
          <% @character.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= tag.div class: "flex flex-col gap-5", data: { controller: "image-cropper", image_cropper_aspect_value: 8.0 / 11, image_cropper_width_value: 480, image_cropper_height_value: 660 } do %>
      <% saved_icon = @character.icon.attached? && @character.icon.blob.persisted? %>
      <label class="flex cursor-pointer flex-col items-center gap-2 pt-2">
        <div style="background-color: color-mix(in srgb, <%= @character.display_color %> 20%, white)" class="flex h-[132px] w-24 items-center justify-center overflow-hidden rounded-xl">
          <% if saved_icon %>
            <%= hidden_field_tag :kept_image, @kept_image if @kept_image %>
            <%= image_tag @character.icon.variant(:display), alt: "今のアイコン画像", data: { image_cropper_target: "image" }, class: "h-full w-full object-cover" %>
          <% else %>
            <img data-image-cropper-target="image" alt="選んだアイコン画像" class="hidden h-full w-full object-cover">
          <% end %>
          <% if @character.persisted? %>
            <span data-image-cropper-target="placeholder" style="color: <%= @character.display_color %>" class="<%= "hidden" if saved_icon %> font-display text-3xl font-bold"><%= @character.name_was.to_s.first %></span>
          <% else %>
            <svg data-image-cropper-target="placeholder" class="h-8 w-8 text-ink-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="m20.5 16-5-5-8 8.5"/></svg>
          <% end %>
          <div data-image-cropper-target="preview" class="hidden h-full w-full overflow-hidden"></div>
        </div>
        <span class="text-[13px] font-bold text-accent-strong"><%= @character.persisted? ? "アイコンを変更" : "アイコン画像を追加" %></span>
        <%= f.file_field :icon, accept: "image/png,image/jpeg,image/webp", data: { image_cropper_target: "fileInput", action: "image-cropper#choose" }, class: "w-full text-xs text-ink-soft file:mr-2 file:rounded-full file:border-0 file:bg-accent-soft file:px-3 file:py-1 file:text-xs file:font-bold file:text-accent-strong" %>
      </label>

      <div data-image-cropper-target="cropArea" class="hidden">
        <div class="flex flex-col items-center gap-3">
          <div class="crop-card aspect-[8/11] w-full max-w-[220px] overflow-hidden rounded-xl bg-ink/5">
            <img data-image-cropper-target="cropImage" alt="切り抜く画像" class="block max-w-full">
          </div>
          <label class="flex w-full max-w-[220px] items-center gap-3 text-xs text-ink-soft">
            <span class="shrink-0">縮小</span>
            <input type="range" min="1" max="4" step="0.01" value="1" data-image-cropper-target="zoom" data-action="input->image-cropper#zoom" aria-label="アイコンの拡大・縮小" class="w-full accent-accent">
            <span class="shrink-0">拡大</span>
          </label>
          <p class="text-xs text-ink-soft">画像をドラッグして、点線の丸の中に顔を入れてください</p>
        </div>
      </div>
    <% end %>

    <div class="flex flex-col gap-1.5">
      <%= f.label :name, class: "flex items-center gap-1.5 text-[15px] font-bold text-ink" do %>
        名前 <span class="rounded-md bg-required px-1.5 py-0.5 text-[11px] font-bold text-white">必須</span>
      <% end %>
      <%= f.text_field :name, required: true, maxlength: 50, placeholder: "例：ヒナタ", class: "h-12 w-full rounded-xl border border-line bg-white px-3 text-base text-ink placeholder:text-ink-faint focus:border-accent focus:outline-none" %>
    </div>

    <div class="flex flex-col gap-1.5">
      <%= f.label :color, "推しの色", class: "text-[15px] font-bold text-ink" %>
      <%= render "shared/color_swatches", controller: "oshi-preview" %>
      <div class="flex items-center gap-3">
        <%= f.color_field :color, value: @character.display_color, data: { oshi_preview_target: "color", action: "input->oshi-preview#updateColor" }, class: "h-12 w-14 shrink-0 cursor-pointer rounded-xl border border-line bg-white p-1" %>
        <div data-oshi-preview-target="bar" class="flex h-12 min-w-0 flex-1 items-center justify-end rounded-xl bg-gradient-to-r from-chara-a via-chara-a-soft to-white px-3 font-display text-base font-bold text-ink"><span class="truncate"><%= @character.name_was.presence || "推しの名前" %></span></div>
      </div>
      <span class="text-xs text-ink-soft">名刺カードやアイコンに、この色のグラデーションがかかります</span>
    </div>

    <% if @character.persisted? %>
      <%= link_to "この推しを消去する", confirm_delete_oshi_path(@character), class: "flex h-12 w-full items-center justify-center rounded-xl border border-danger bg-white text-sm font-bold text-danger" %>
    <% end %>
  </div>

  <div class="fixed inset-x-0 bottom-0 z-20 mx-auto max-w-[430px] border-t border-line bg-white px-5 pt-3 pb-5">
    <%= f.submit submit_label, class: "w-full cursor-pointer rounded-2xl bg-accent py-3.5 font-display text-base font-bold text-on-accent transition hover:bg-accent-strong active:scale-95" %>
  </div>
<% end %>
