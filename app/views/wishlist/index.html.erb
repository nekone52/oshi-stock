<div class="mx-auto max-w-[430px] px-4 pb-10">

  <!-- ヘッダー(見出しと追加ボタン) -->
  <%# ホームに戻る(下のメニューのかわり) %>
  <%= render "shared/home_link" %>
  <header class="flex items-center justify-between gap-3 pt-1 pb-3">
    <h1 class="font-display text-2xl font-bold text-ink">グッズ</h1>
    <%= link_to "＋ ほしい物を追加", new_wishlist_path, class: "inline-flex h-11 shrink-0 items-center rounded-full bg-accent px-4 text-sm font-bold text-on-accent transition hover:bg-accent-strong active:scale-95" %>
  </header>

  <!-- 所持グッズ / ほしい物の切り替え -->
  <div class="grid grid-cols-2 gap-1 rounded-xl bg-accent-soft/60 p-1">
    <%= link_to "所持グッズ", goods_path, class: "flex h-10 items-center justify-center rounded-lg text-sm text-ink" %>
    <%= link_to "ほしい物", wishlist_path, aria: { current: "page" }, class: "flex h-10 items-center justify-center rounded-lg bg-white text-sm font-bold text-accent-strong" %>
  </div>

  <!-- 検索欄 -->
  <div class="relative mt-3">
    <label for="wish-search" class="sr-only">ほしい物を検索</label>
    <svg class="pointer-events-none absolute top-1/2 left-3.5 h-[18px] w-[18px] -translate-y-1/2 text-ink-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
    <input id="wish-search" type="search" placeholder="グッズ名・推しで検索" class="h-12 w-full rounded-xl border border-line bg-white pr-4 pl-11 text-base text-ink placeholder:text-ink-faint">
  </div>

  <!-- カテゴリの絞り込み(横にスクロール) -->
  <nav aria-label="カテゴリで絞り込み" class="-mx-4 mt-3 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <button type="button" aria-pressed="true" class="h-9 shrink-0 rounded-full bg-ink px-3.5 text-[13px] font-bold text-white">すべて 3</button>
    <button type="button" aria-pressed="false" class="h-9 shrink-0 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">アクスタ 1</button>
    <button type="button" aria-pressed="false" class="h-9 shrink-0 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">缶バッジ 1</button>
    <button type="button" aria-pressed="false" class="h-9 shrink-0 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">ぬいぐるみ 1</button>
  </nav>

  <!-- ほしい物のカード(縦に並べる。画像がまだ無いものも並ぶ) -->
  <ul class="mt-3 flex flex-col gap-2.5">
    <% [
      { name: "ぬいぐるみマスコット", chara: "ヒナタ", price: "¥2,750", category: "ぬいぐるみ", release: "12月", tone: "bg-chara-a-soft text-chara-a", memo: "特典付き" },
      { name: "ミニアクスタ 第3弾", chara: "リン", price: "¥880", category: "アクスタ", release: "未定", tone: nil, memo: nil },
      { name: "缶バッジ イベント限定", chara: "アオイ", price: "¥550", category: "缶バッジ", release: "1月上旬", tone: "bg-chara-b-soft text-chara-b", memo: "再販待ち" }
    ].each do |item| %>
      <li class="flex flex-col gap-2.5 rounded-2xl border border-line bg-white p-3">
        <div class="flex gap-3">
          <!-- 商品画像(無いときは「URLのみ」) -->
          <% if item[:tone] %>
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl <%= item[:tone] %>">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="m20.5 16-5-5-8 8.5"/></svg>
            </div>
          <% else %>
            <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center gap-0.5 rounded-xl border border-dashed border-line bg-bg text-ink-faint">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
              <span class="text-[10px] font-bold">URLのみ</span>
            </div>
          <% end %>
          <!-- グッズの情報 -->
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <div class="flex items-center gap-1.5">
              <span class="rounded bg-line px-1.5 py-px text-xs font-bold text-ink-soft"><%= item[:category] %></span>
              <span class="text-[13px] text-ink-soft">発売 <%= item[:release] %></span>
            </div>
            <div class="flex items-baseline justify-between gap-2">
              <span class="line-clamp-2 text-base font-bold text-ink"><%= item[:name] %></span>
              <span class="shrink-0 text-[15px] font-bold text-ink"><%= item[:price] %></span>
            </div>
            <span class="text-[13px] text-ink-soft"><%= item[:chara] %></span>
          </div>
        </div>
        <!-- メモ(書いてあるときだけ出す) -->
        <% if item[:memo] %>
          <p class="flex items-start gap-1.5 rounded-lg bg-bg px-2.5 py-2 text-[13px] text-ink">
            <svg class="mt-px h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="M9 9h6M9 13h6M9 17h3"/></svg>
            <span class="line-clamp-2"><%= item[:memo] %></span>
          </p>
        <% end %>
        <!-- ワンタップの切り替え(予約した → 予約注文へ / 買った → 所持グッズへ) -->
        <div class="grid grid-cols-2 gap-2">
          <button type="button" class="h-10 rounded-xl border border-accent bg-accent-soft text-[13px] font-bold text-accent-strong">予約した</button>
          <button type="button" class="h-10 rounded-xl border border-line bg-white text-[13px] text-ink">買った</button>
        </div>
      </li>
    <% end %>
  </ul>
</div>
