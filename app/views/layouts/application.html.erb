<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# OGP:リンクを貼ったときに SNS が読む「帯」(タイトル・説明・画像)。画像は public/ogp.png %>
    <% ogp_description = "推し活グッズの持ち物・予約・ほしい物を、まとめて管理できるアプリ" %>
    <meta property="og:title" content="推しストック">
    <meta property="og:description" content="<%= ogp_description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= root_url %>">
    <%# 【自分の言葉】リンクを貼ったら、アプリの説明画像(public/ogp.png)が見えるようにするため %>
    <meta property="og:image" content="<%= "#{request.base_url}/ogp.png" %>">
    <meta property="og:site_name" content="推しストック">
    <meta name="description" content="<%= ogp_description %>">
    <%# X(旧 Twitter)で大きい画像のカードにする %>
    <meta name="twitter:card" content="summary_large_image">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-bg font-body text-ink antialiased" style="<%= theme_style %>">
    <% flash.each do |type, message| %>
      <% good = type.in?(%w[notice celebrate]) %>
      <% celebrate = type == "celebrate" %>
      <div role="status" data-controller="flash" class="pointer-events-none fixed inset-x-0 top-18 z-50 mx-auto flex w-[calc(100%-2rem)] max-w-[398px] items-center justify-center gap-3 transition-opacity duration-500 <%= "motion-safe:animate-poyon" if celebrate %>">
        <% if celebrate %>
          <%= image_tag %w[mascot_girl.png mascot_boy.png].sample, alt: "", class: "h-24 w-24 shrink-0 rounded-full bg-white object-contain shadow-lg" %>
        <% end %>
        <div class="relative min-w-0 rounded-2xl bg-white shadow-lg <%= "flex-1" if celebrate %>">
          <% if celebrate %>
            <span class="absolute top-1/2 -left-2 h-4 w-4 -translate-y-1/2 rotate-45 bg-white" aria-hidden="true"></span>
          <% end %>
          <div class="relative flex items-center gap-2.5 overflow-hidden rounded-2xl font-display font-bold <%= celebrate ? "px-5 py-5 text-lg" : "px-4 py-3 text-base" %> <%= good ? "text-ink" : "text-danger" %>">
            <% if good %>
              <svg class="h-8 w-8 shrink-0 text-paid" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9z"/><path d="M19 15l.8 2.2 2.2.8-2.2.8L19 21l-.8-2.2-2.2-.8 2.2-.8z"/></svg>
            <% else %>
              <svg class="h-8 w-8 shrink-0 text-danger" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5v.01"/></svg>
            <% end %>
            <span><%= message %></span>
            <span class="pointer-events-none absolute inset-y-0 left-0 w-1/3 animate-shine bg-gradient-to-r from-transparent via-accent-soft/80 to-transparent" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    <% end %>

    <dialog id="confirm_dialog" aria-labelledby="confirm_dialog_title" class="m-auto w-[calc(100%-3rem)] max-w-[340px] rounded-2xl bg-white p-0 shadow-xl backdrop:bg-ink/40">
      <form method="dialog" class="flex flex-col items-center gap-3 px-5 pt-5 pb-5 text-center">
        <%= image_tag "confirm_delete.png", alt: "", class: "w-full max-w-[240px]" %>
        <h2 id="confirm_dialog_title" class="font-display text-xl font-bold text-ink"><span class="text-danger">消去</span>しますか？</h2>
        <p data-confirm-message class="whitespace-pre-line text-sm leading-relaxed text-ink"></p>
        <div class="mt-1 grid w-full grid-cols-2 gap-2">
          <button value="cancel" class="h-11 cursor-pointer rounded-xl border border-line bg-white text-sm text-ink">やめる</button>
          <button value="confirm" class="h-11 cursor-pointer rounded-xl bg-danger text-sm font-bold text-white">消去する</button>
        </div>
      </form>
    </dialog>

    <div <%= "inert" unless content_for?(:interactive) %>>
      <%= yield %>
    </div>
  </body>
</html>
