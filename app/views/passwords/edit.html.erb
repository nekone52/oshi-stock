<% content_for :interactive, true %>

<div class="flex min-h-screen items-center justify-center px-4">
  <div class="relative w-full max-w-[430px]">

    <div class="absolute inset-x-0 bottom-full mb-10">
      <%= image_tag "logo.png", alt: "推しストック", class: "w-full" %>
    </div>

    <div class="overflow-hidden rounded-2xl border border-line bg-white shadow-sm">

      <div class="bg-hdr px-4 py-3">
        <h1 class="font-display text-base font-bold text-white">新しいパスワード</h1>
      </div>

      <%= form_with url: password_path(params[:token]), method: :put do |f| %>
        <div class="flex flex-col gap-3 p-4">
          <p class="text-[13px] leading-relaxed text-ink">新しいパスワードを決めてください(8文字以上)。</p>
          <label class="flex flex-col gap-1">
            <span class="text-xs text-ink-soft">新しいパスワード</span>
            <div class="relative" data-controller="password-visibility">
              <%= f.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", placeholder: "••••••••", data: { password_visibility_target: "input" }, class: "w-full pr-11 rounded-lg border border-line bg-bg px-3 py-2 text-base placeholder:text-ink-faint focus:border-accent focus:outline-none" %>
              <%= render "shared/password_visibility_button" %>
            </div>
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-xs text-ink-soft">新しいパスワード(確認)</span>
            <div class="relative" data-controller="password-visibility">
              <%= f.password_field :password_confirmation, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", placeholder: "••••••••", data: { password_visibility_target: "input" }, class: "w-full pr-11 rounded-lg border border-line bg-bg px-3 py-2 text-base placeholder:text-ink-faint focus:border-accent focus:outline-none" %>
              <%= render "shared/password_visibility_button" %>
            </div>
          </label>
        </div>

        <div class="flex flex-col items-center gap-3 px-4 pb-5">
          <%= f.submit "パスワードを変更する", class: "w-full cursor-pointer rounded-full bg-accent px-6 py-2.5 font-display text-sm font-bold text-on-accent transition hover:-translate-y-0.5 hover:shadow-md active:scale-95" %>
        </div>
      <% end %>

      <div class="flex flex-col items-center gap-2 border-t border-line bg-bg px-4 py-4">
        <p class="text-xs text-ink-soft">ログイン画面に戻る</p>
        <%= link_to "ログイン", new_session_path, class: "w-full rounded-full border-2 border-accent bg-white px-6 py-2 text-center font-display text-sm font-bold text-accent-strong transition hover:bg-accent-soft active:scale-95" %>
      </div>

    </div>
  </div>
</div>
