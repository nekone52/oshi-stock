<% content_for :interactive, true %>

<%# ロゴ → 箱 の順にふつうに並べて、2つまとめてまん中に置く(PC の低い画面でもロゴが切れない) %>
<div class="flex min-h-screen items-center justify-center px-4 py-8">
  <div class="flex w-full max-w-[430px] flex-col gap-10">

    <div>
      <%= image_tag "logo.png", alt: "推しストック", class: "w-full" %>
    </div>

    <div class="overflow-hidden rounded-2xl border border-line bg-white shadow-sm">

      <div class="bg-hdr px-4 py-3">
        <h1 class="font-display text-base font-bold text-white">パスワードの再設定</h1>
      </div>

      <%= form_with url: passwords_path do |f| %>
        <div class="flex flex-col gap-3 p-4">
          <p class="text-[13px] leading-relaxed text-ink">登録したメールアドレスを入れてください。パスワードを再設定するためのリンクを送ります。</p>
          <label class="flex flex-col gap-1">
            <span class="text-xs text-ink-soft">メールアドレス</span>
            <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "example@mail.com", value: params[:email_address], class: "rounded-lg border border-line bg-bg px-3 py-2 text-base placeholder:text-ink-faint focus:border-accent focus:outline-none" %>
          </label>
        </div>

        <div class="flex flex-col items-center gap-3 px-4 pb-5">
          <%= f.submit "再設定のメールを送る", class: "w-full cursor-pointer rounded-full bg-accent px-6 py-2.5 font-display text-sm font-bold text-on-accent transition hover:-translate-y-0.5 hover:shadow-md active:scale-95" %>
        </div>
      <% end %>

      <div class="flex flex-col items-center gap-2 border-t border-line bg-bg px-4 py-4">
        <p class="text-xs text-ink-soft">パスワードを思い出した方はこちら</p>
        <%= link_to "ログイン", new_session_path, class: "w-full rounded-full border-2 border-accent bg-white px-6 py-2 text-center font-display text-sm font-bold text-accent-strong transition hover:bg-accent-soft active:scale-95" %>
      </div>

    </div>
  </div>
</div>
