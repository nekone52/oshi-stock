<div class="mx-auto max-w-[430px] px-4 pb-28">

  <!-- ヘッダー(見出しと登録ボタン) -->
  <header class="flex items-center justify-between pt-6 pb-3">
    <h1 class="font-display text-2xl font-bold text-ink">グッズ</h1>
    <%= link_to "グッズを登録", new_good_path, class: "inline-flex h-11 items-center gap-1.5 rounded-full bg-accent px-4 text-sm font-bold text-white transition hover:bg-accent-strong active:scale-95" %>
  </header>

  <!-- 所持グッズ / ほしい物の切り替え -->
  <div class="grid grid-cols-2 gap-1 rounded-xl bg-accent-soft/60 p-1">
    <%= link_to "所持グッズ", goods_path, aria: { current: "page" }, class: "flex h-10 items-center justify-center rounded-lg bg-white text-sm font-bold text-accent-strong" %>
    <%= link_to "ほしい物", wishlist_path, class: "flex h-10 items-center justify-center rounded-lg text-sm text-ink" %>
  </div>

  <!-- 検索欄 -->
  <div class="relative mt-3">
    <label for="goods-search" class="sr-only">所持グッズを検索</label>
    <svg class="pointer-events-none absolute top-1/2 left-3.5 h-[18px] w-[18px] -translate-y-1/2 text-ink-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
    <input id="goods-search" type="search" placeholder="グッズ名・推し・作品名で検索" class="h-12 w-full rounded-xl border border-line bg-white pr-4 pl-11 text-[15px] text-ink placeholder:text-ink-faint">
  </div>

  <!-- カテゴリの絞り込み(横にスクロール) -->
  <nav aria-label="カテゴリで絞り込み" class="-mx-4 mt-3 flex gap-2 overflow-x-auto px-4 pb-1">
    <button type="button" aria-pressed="false" class="h-9 shrink-0 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">すべて 42</button>
    <button type="button" aria-pressed="true" class="h-9 shrink-0 rounded-full bg-ink px-3.5 text-[13px] font-bold text-white">アクスタ 9</button>
    <button type="button" aria-pressed="false" class="h-9 shrink-0 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">缶バッジ 18</button>
    <button type="button" aria-pressed="false" class="h-9 shrink-0 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">ぬいぐるみ 4</button>
    <button type="button" aria-pressed="false" class="h-9 shrink-0 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">ブロマイド 11</button>
  </nav>

  <div class="mt-3 flex items-center justify-between">
    <span class="text-[13px] text-ink-soft">アクスタ · 9件</span>
    <span class="text-[13px] text-ink-soft">並び替え：新しい順</span>
  </div>

  <!-- 所持グッズのカード(2列) -->
  <div class="mt-2 grid grid-cols-2 gap-3">
    <% [
      { name: "アクリルスタンド", category: "アクスタ", chara: "ミナト", qty: 2, tone: "bg-chara-b-soft text-chara-b" },
      { name: "誕生日アクスタ 2026", category: "アクスタ", chara: "ソラ", qty: 1, tone: "bg-accent-soft text-accent-strong" },
      { name: "ミニアクスタ", category: "アクスタ", chara: "ハル", qty: 3, tone: "bg-chara-c-soft text-chara-c" },
      { name: "コラボカフェ アクスタ", category: "アクスタ", chara: "ツムギ", qty: 1, tone: "bg-unpaid-bg text-unpaid" }
    ].each do |goods| %>
      <%= link_to "#", class: "flex flex-col overflow-hidden rounded-2xl border border-line bg-white" do %>
        <div class="flex h-24 items-center justify-center <%= goods[:tone] %>">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="m20.5 16-5-5-8 8.5"/></svg>
        </div>
        <div class="flex flex-col gap-1 p-2.5">
          <span class="self-start rounded bg-line px-1.5 py-px text-[11px] font-bold text-ink-soft"><%= goods[:category] %></span>
          <span class="text-sm font-bold text-ink"><%= goods[:name] %></span>
          <span class="flex justify-between text-xs text-ink-soft"><span><%= goods[:chara] %></span><span>×<%= goods[:qty] %></span></span>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<%= render "shared/bottom_nav", active: :goods %>
