<%# 日付をカレンダーで選ぶ部品(支払期限と同じ見た目)。field = 項目の名前、label = 見出し、empty = 空っぽのときの文字 %>
<div class="flex flex-col gap-1.5" data-controller="deadline-picker" data-deadline-picker-empty-value="<%= empty %>">
  <span id="<%= field %>_label" class="text-[15px] font-bold text-ink"><%= label %></span>
  <%= f.hidden_field field, data: { deadline_picker_target: "input" } %>
  <button type="button" aria-labelledby="<%= field %>_label" aria-expanded="false" aria-controls="<%= field %>_panel"
          data-deadline-picker-target="button" data-action="deadline-picker#toggle"
          class="flex min-h-16 w-full cursor-pointer items-center gap-3 rounded-2xl border-[1.5px] border-line bg-white px-3.5 py-2 text-left aria-expanded:border-accent">
    <span class="flex h-[42px] w-[42px] shrink-0 flex-col overflow-hidden rounded-[10px] border-[1.5px] border-accent text-center" aria-hidden="true">
      <b class="bg-accent text-[10px] leading-[14px] text-white" data-deadline-picker-target="calMonth">—</b>
      <span class="grid flex-1 place-items-center font-display text-lg text-accent-strong" data-deadline-picker-target="calDay">?</span>
    </span>
    <span class="flex min-w-0 flex-1 flex-col gap-0.5">
      <strong class="font-display text-[19px] text-ink" data-deadline-picker-target="text"><%= empty %></strong>
      <small class="text-[13px] text-ink-soft" data-deadline-picker-target="left">押すとカレンダーがひらきます</small>
    </span>
    <span class="text-lg text-ink-faint" aria-hidden="true">⌄</span>
  </button>
  <div id="<%= field %>_panel" data-deadline-picker-target="panel" hidden></div>
</div>
