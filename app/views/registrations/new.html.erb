<% content_for :interactive, true %>

<div class="flex min-h-screen items-center justify-center px-4">
  <div class="relative w-full max-w-[430px]">

    <div class="absolute inset-x-0 bottom-full mb-10">
      <%= image_tag "logo.png", alt: "推しストック", class: "w-full" %>
    </div>

    <div class="overflow-hidden rounded-2xl border border-line bg-white shadow-sm">

      <div class="bg-hdr px-4 py-3">
        <h1 class="font-display text-base font-bold text-white">新規登録</h1>
      </div>

      <%= form_with model: @user, url: registration_path do |f| %>

        <div class="flex flex-col gap-3 p-4">
          <% if @user.errors.any? %>
            <div role="alert" class="rounded-lg bg-danger-bg px-3 py-2 text-[13px] text-danger">
              <ul class="list-disc space-y-0.5 pl-4">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <label class="flex flex-col gap-1">
            <span class="flex items-center gap-1.5 text-[15px] font-bold text-ink">メールアドレス <span class="rounded-md bg-required px-1.5 py-0.5 text-[11px] font-bold text-white">必須</span></span>
            <%= f.email_field :email_address, required: true, autocomplete: "email", placeholder: "example@mail.com", class: "rounded-lg border border-line bg-bg px-3 py-2 text-base placeholder:text-ink-faint focus:border-accent focus:outline-none" %>
          </label>

          <label class="flex flex-col gap-1">
            <span class="flex items-center gap-1.5 text-[15px] font-bold text-ink">パスワード(8文字以上) <span class="rounded-md bg-required px-1.5 py-0.5 text-[11px] font-bold text-white">必須</span></span>
            <div class="relative" data-controller="password-visibility">
              <%= f.password_field :password, required: true, minlength: 8, autocomplete: "new-password", placeholder: "••••••••", data: { password_visibility_target: "input" }, class: "w-full pr-11 rounded-lg border border-line bg-bg px-3 py-2 text-base placeholder:text-ink-faint focus:border-accent focus:outline-none" %>
              <%= render "shared/password_visibility_button" %>
            </div>
          </label>

          <label class="flex flex-col gap-1">
            <span class="flex items-center gap-1.5 text-[15px] font-bold text-ink">パスワード(確認) <span class="rounded-md bg-required px-1.5 py-0.5 text-[11px] font-bold text-white">必須</span></span>
            <div class="relative" data-controller="password-visibility">
              <%= f.password_field :password_confirmation, required: true, minlength: 8, autocomplete: "new-password", placeholder: "••••••••", data: { password_visibility_target: "input" }, class: "w-full pr-11 rounded-lg border border-line bg-bg px-3 py-2 text-base placeholder:text-ink-faint focus:border-accent focus:outline-none" %>
              <%= render "shared/password_visibility_button" %>
            </div>
          </label>
        </div>

        <div class="flex flex-col items-center gap-3 px-4 pb-5">
          <p class="text-xs leading-relaxed text-ink-soft">登録すると、<%= link_to "利用規約", terms_path, class: "font-bold text-accent-strong underline" %>と<%= link_to "プライバシーポリシー", privacy_path, class: "font-bold text-accent-strong underline" %>に同意したことになります。</p>
          <%= f.submit "登録する", class: "w-full cursor-pointer rounded-full bg-accent px-6 py-2.5 font-display text-sm font-bold text-on-accent transition hover:-translate-y-0.5 hover:shadow-md active:scale-95" %>
        </div>
      <% end %>

      <div class="flex flex-col items-center gap-2 border-t border-line bg-bg px-4 py-4">
        <p class="text-xs text-ink-soft">アカウントをお持ちの方はこちら</p>
        <%= link_to "ログイン", new_session_path, class: "w-full rounded-full border-2 border-accent bg-white px-6 py-2 text-center font-display text-sm font-bold text-accent-strong transition hover:bg-accent-soft active:scale-95" %>
      </div>

    </div>
  </div>
</div>
