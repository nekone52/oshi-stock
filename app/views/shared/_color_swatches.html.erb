<div class="flex flex-col gap-2">
  <span class="text-xs font-bold text-ink-soft">推しの色(おすすめ)</span>
  <div class="grid grid-cols-6 gap-x-1 gap-y-2.5">
    <% ThemeHelper::THEME_SWATCHES.each do |name, color| %>
      <button type="button" data-<%= controller %>-target="swatch" data-color="<%= color %>" data-action="<%= controller %>#pick" aria-pressed="false"
              class="group flex min-w-0 cursor-pointer flex-col items-center gap-1 text-center text-[10px] leading-tight text-ink-soft aria-pressed:font-bold aria-pressed:text-ink">
        <span style="background-color: <%= color %>" class="h-10 w-10 rounded-full ring-1 ring-black/5 group-aria-pressed:ring-2 group-aria-pressed:ring-ink group-aria-pressed:ring-offset-2"></span>
        <%= name %>
      </button>
    <% end %>
  </div>
</div>
