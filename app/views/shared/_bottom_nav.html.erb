<%# 下のメニュー(全画面共通)。active には今の画面のキーを渡す %>
<% tabs = [
  { key: :home, label: "ホーム", path: root_path, icon: "M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z" },
  { key: :goods, label: "グッズ", path: goods_path, icon: "M3 7.5 12 3l9 4.5v9L12 21l-9-4.5zM3 7.5 12 12l9-4.5M12 12v9" },
  { key: :oshi, label: "推し", path: root_path, icon: "M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" },
  { key: :reservations, label: "予約", path: reservations_path, icon: "M3.5 5h17v15h-17zM3.5 10h17M8 3v4M16 3v4" },
  { key: :settings, label: "設定", path: settings_path, icon: "M4 7h10M18 7h2M4 17h4M12 17h8M16 7a2 2 0 1 0 0 .01M10 17a2 2 0 1 0 0 .01" }
] %>
<nav aria-label="メインメニュー" class="fixed inset-x-0 bottom-0 z-20 mx-auto grid max-w-[430px] grid-cols-5 border-t border-line bg-white px-1 pt-1.5 pb-[calc(0.75rem+env(safe-area-inset-bottom))]">
  <% tabs.each do |tab| %>
    <% current = tab[:key] == active %>
    <%= link_to tab[:path], aria: { current: (current ? "page" : nil) }, class: "flex min-h-[52px] flex-col items-center justify-center gap-0.5 text-[11px] #{current ? 'font-bold text-accent-strong' : 'text-ink-soft'}" do %>
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= tab[:icon] %>"/></svg>
      <%= tab[:label] %>
    <% end %>
  <% end %>
</nav>
