<% content_for :interactive, true %>

<div class="mx-auto max-w-[430px] px-4 pb-10">

  <%= render "shared/home_link" %>
  <header class="flex items-center justify-between gap-3 pt-1 pb-3">
    <h1 class="font-display text-2xl font-bold text-ink">予約</h1>
    <%= link_to "＋ 予約を登録", new_good_path(status: "reserved"), class: "inline-flex h-11 shrink-0 items-center rounded-full bg-accent px-4 text-sm font-bold text-on-accent transition hover:bg-accent-strong active:scale-95" %>
  </header>

  <section aria-label="支払いのまとめ" class="flex flex-col gap-2.5 rounded-2xl border border-line bg-white p-4 text-ink">
    <span class="text-[13px] text-ink-soft">これから支払う金額</span>
    <span class="font-display text-[32px] leading-none font-bold">¥<%= number_with_delimiter(@unpaid_total) %></span>
    <div class="flex flex-wrap gap-2">
      <span class="rounded-lg bg-bg px-2.5 py-1 text-[13px] text-ink">予約 <%= @reserved_count %>件</span>
      <span class="rounded-lg bg-bg px-2.5 py-1 text-[13px] text-ink">未払い <%= @unpaid_count %>件</span>
      <% if @due_soon_count.positive? %>
        <span class="rounded-lg bg-unpaid-bg px-2.5 py-1 text-[13px] font-bold text-unpaid">期限7日以内 <%= @due_soon_count %>件</span>
      <% end %>
    </div>
  </section>

  <% selected_class = "inline-flex h-10 shrink-0 items-center rounded-full bg-ink px-4 text-[13px] font-bold text-white" %>
  <% normal_class   = "inline-flex h-10 shrink-0 items-center rounded-full border border-line bg-white px-3.5 text-[13px] text-ink" %>
  <nav aria-label="絞り込み" class="mt-3 flex gap-2 overflow-x-auto">
    <%= link_to "すべて", reservations_path(character_id: params[:character_id]), class: params[:filter].blank? ? selected_class : normal_class %>
    <%= link_to "未払い", reservations_path(filter: "unpaid", character_id: params[:character_id]), class: params[:filter] == "unpaid" ? selected_class : normal_class %>
    <%= link_to "支払済", reservations_path(filter: "paid", character_id: params[:character_id]), class: params[:filter] == "paid" ? selected_class : normal_class %>
    <%= link_to "届いた・未払い", reservations_path(filter: "arrived", character_id: params[:character_id]), class: params[:filter] == "arrived" ? selected_class : normal_class %>
  </nav>

  <% if @selected_character %>
    <section aria-label="推しで絞りこみ中" class="mt-3 flex items-center justify-between gap-3 rounded-2xl border border-line bg-white px-4 py-3">
      <div class="flex min-w-0 items-center gap-2.5">
        <span style="background-color: <%= @selected_character.display_color %>" class="h-3.5 w-3.5 shrink-0 rounded-full" aria-hidden="true"></span>
        <div class="flex min-w-0 flex-col">
          <span class="truncate text-[15px] text-ink"><span class="font-bold"><%= @selected_character.name %></span> で絞りこみ中</span>
          <span class="text-[13px] text-ink-soft">予約 <%= @reserved_items.size %>件</span>
        </div>
      </div>
      <%= link_to reservations_path, aria: { label: "絞り込みをやめる" }, class: "inline-flex h-10 shrink-0 items-center gap-1 rounded-full border-2 border-ink bg-white px-3.5 text-[13px] font-bold text-ink transition hover:bg-bg active:scale-95" do %>
        やめる <span aria-hidden="true">×</span>
      <% end %>
    </section>
  <% end %>

  <% if @waiting_items.any? %>
    <a href="#waiting" class="mt-3 flex items-center gap-2 rounded-full border-[1.5px] border-dashed border-ink-faint bg-white px-4 py-2 text-[13px] text-ink">
      <span class="font-bold">発売日待ち</span>
      <span class="text-xs text-ink-soft"><%= @waiting_items.size %>件</span>
      <span class="ml-auto text-ink-soft">見る ↓</span>
    </a>
  <% end %>

  <% @items_by_month.each do |release_month, items| %>
    <% now = release_month.beginning_of_month == Date.current.beginning_of_month %>
    <section class="mt-2">
      <div class="sticky top-0 z-10 flex items-baseline gap-2 bg-bg px-1 pt-4 pb-2">
        <span class="font-display text-[17px] font-bold <%= now ? "text-accent-strong" : "text-ink" %>"><span class="text-xs text-ink-soft"><%= release_month.year %>年</span><%= release_month.month %>月発売</span>
        <% if now %>
          <span class="self-center rounded-full bg-accent px-2 py-0.5 text-[10px] font-bold text-on-accent">今月</span>
        <% end %>
        <span class="text-[13px] text-ink-soft"><%= items.size %>件 · ¥<%= number_with_delimiter(@month_totals[release_month]) %></span>
        <span class="h-px flex-1 self-center bg-line"></span>
      </div>
      <ul class="flex flex-col gap-2.5">
        <%= render partial: "card", collection: items, as: :item %>
      </ul>
    </section>
  <% end %>

  <% if @waiting_items.any? %>
    <details id="waiting" class="mt-6 rounded-2xl border-[1.5px] border-dashed border-ink-faint bg-white/50 px-2.5 py-1">
      <summary class="flex cursor-pointer list-none items-center gap-2 px-0.5 py-2.5">
        <span class="font-display text-[15px] font-bold text-ink">発売日待ち</span>
        <span class="text-xs text-ink-soft"><%= @waiting_items.size %>件</span>
        <span class="ml-auto text-xs text-ink-soft">ひらく ▼</span>
      </summary>
      <ul class="mb-2.5 flex flex-col gap-2.5">
        <%= render partial: "card", collection: @waiting_items, as: :item %>
      </ul>
    </details>
  <% end %>
</div>
