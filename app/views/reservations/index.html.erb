<%# 【予約の画面のモック(見た目だけ)】本リリースで本物にする予定。決まった見た目は、ノーション「47」にまとめてある %>
<%# 決まったこと:発売月ごとに見出しで分ける / 発売日待ちは、上に小さいお知らせ + いちばん下の点線の箱にたたむ %>
<%#             「支払った」「届いた」は、どちらも白地に色の枠(緑・¥ / ピンク・箱)で、押しまちがいを防ぐ %>
<%
  # 見た目を確かめるための例のデータ(本物のデータではない)
  # chara:推しの色(a / b / c) icon:画像がないときの絵 due:支払い期限まであと何日(nil は未定)
  waiting = [
    { name: "アクスタ 新作(詳細まだ)", chara: "a", oshi: "アオイ", shop: "アニメイト", release: "発売日待ち", price: "¥1,980", qty: 1, state: :unpaid, due: nil }
  ]
  # 推しの色(Tailwind のクラス名は、文字をつなげて作ると CSS に入らないので、まるごと書いておく)
  colors = {
    "a" => { dot: "bg-chara-a", thumb: "bg-chara-a-soft text-chara-a" },
    "b" => { dot: "bg-chara-b", thumb: "bg-chara-b-soft text-chara-b" },
    "c" => { dot: "bg-chara-c", thumb: "bg-chara-c-soft text-chara-c" }
  }
%>

<div class="mx-auto max-w-[430px] px-4 pb-28">

  <!-- ヘッダー(見出しと追加ボタン) -->
  <header class="flex items-center justify-between gap-3 pt-6 pb-3">
    <h1 class="font-display text-2xl font-bold text-ink">予約</h1>
    <%= link_to "＋ 予約を登録", new_reservation_path, class: "inline-flex h-11 shrink-0 items-center rounded-full bg-accent px-4 text-sm font-bold text-on-accent transition hover:bg-accent-strong active:scale-95" %>
  </header>

  <!-- これから支払う金額(本物。数字はコントローラーのお皿から。期限7日以内は、あるときだけ出す) -->
  <section aria-label="支払いのまとめ" class="flex flex-col gap-2.5 rounded-2xl border border-line bg-white p-4 text-ink">
    <span class="text-[13px] text-ink-soft">これから支払う金額</span>
    <span class="font-display text-[32px] leading-none font-bold">¥<%= number_with_delimiter(@unpaid_total) %></span>
    <div class="flex flex-wrap gap-2">
      <span class="rounded-lg bg-bg px-2.5 py-1 text-[13px] text-ink">予約 <%= @reserved_items.size %>件</span>
      <span class="rounded-lg bg-bg px-2.5 py-1 text-[13px] text-ink">未払い <%= @unpaid_count %>件</span>
      <% if @due_soon_count.positive? %>
        <span class="rounded-lg bg-unpaid-bg px-2.5 py-1 text-[13px] font-bold text-unpaid">期限7日以内 <%= @due_soon_count %>件</span>
      <% end %>
    </div>
  </section>

  <!-- 絞り込み -->
  <nav aria-label="絞り込み" class="mt-3 flex gap-2 overflow-x-auto">
    <button type="button" aria-pressed="true" class="h-10 shrink-0 rounded-full bg-ink px-4 text-[13px] font-bold text-white">すべて</button>
    <button type="button" aria-pressed="false" class="h-10 shrink-0 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">未払い</button>
    <button type="button" aria-pressed="false" class="h-10 shrink-0 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">支払済</button>
    <button type="button" aria-pressed="false" class="h-10 shrink-0 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">届いた・未払い</button>
  </nav>

  <!-- 発売日待ちのお知らせ(押すと、いちばん下の点線の箱へ飛ぶ。場所をとらない小さいバー) -->
  <a href="#waiting" class="mt-3 flex items-center gap-2 rounded-full border-[1.5px] border-dashed border-ink-faint bg-white px-4 py-2 text-[13px] text-ink">
    <span class="font-bold">発売日待ち</span>
    <span class="text-xs text-ink-soft"><%= waiting.size %>件 · ¥1,980</span>
    <span class="ml-auto text-ink-soft">見る ↓</span>
  </a>

  <!-- 発売月ごとの予約(本物。箱はコントローラーで発売月ごとに仕分け済み。月の見出しは、スクロールしても上に残る) -->
  <%# release_month = 発売月(例:2026-10-01。名前は自由で、テーブルの項目名とそろえた) / items = その月のグッズたち %>
  <% @items_by_month.each do |release_month, items| %>
    <% now = release_month.beginning_of_month == Date.current.beginning_of_month %><%# 今月かどうか(今月だけ色を変えて「今月」のしるしをつける) %>
    <section class="mt-2">
      <div class="sticky top-0 z-10 flex items-baseline gap-2 bg-bg px-1 pt-4 pb-2">
        <%# 【自分の言葉】予約している発売日から、月の数字だけ取り出す(10月発売 など) %>
        <span class="font-display text-[17px] font-bold <%= now ? "text-accent-strong" : "text-ink" %>"><%= release_month.month %>月発売</span>
        <% if now %>
          <span class="self-center rounded-full bg-accent px-2 py-0.5 text-[10px] font-bold text-on-accent">今月</span>
        <% end %>
        <span class="text-[13px] text-ink-soft"><%= items.size %>件</span>
        <span class="h-px flex-1 self-center bg-line"></span>
      </div>
      <ul class="flex flex-col gap-2.5">
        <%# 仮の表示(名前だけ)。次の項目で、本物のカード(_card)にする %>
        <% items.each do |item| %>
          <li class="rounded-2xl border border-line bg-white p-3 text-[15px] font-bold text-ink"><%= item.name %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <!-- 発売日待ち(いちばん下の点線の箱。ふだんはたたんでおく) -->
  <details id="waiting" class="mt-6 rounded-2xl border-[1.5px] border-dashed border-ink-faint bg-white/50 px-2.5 py-1">
    <summary class="flex cursor-pointer list-none items-center gap-2 px-0.5 py-2.5">
      <span class="font-display text-[15px] font-bold text-ink">発売日待ち</span>
      <span class="text-xs text-ink-soft"><%= waiting.size %>件 · ¥1,980</span>
      <span class="ml-auto text-xs text-ink-soft">ひらく ▼</span>
    </summary>
    <ul class="mb-2.5 flex flex-col gap-2.5">
      <% waiting.each do |item| %>
        <%= render "reservations/card", item: item, colors: colors %>
      <% end %>
    </ul>
  </details>
</div>

<%= render "shared/bottom_nav", active: :reservations %>
