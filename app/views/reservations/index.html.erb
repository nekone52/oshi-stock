<div class="mx-auto max-w-[430px] px-4 pb-28">

  <!-- ヘッダー(見出しと登録ボタン) -->
  <header class="flex items-center justify-between pt-6 pb-3">
    <h1 class="font-display text-2xl font-bold text-ink">予約注文</h1>
    <%= link_to "予約を登録", new_reservation_path, class: "inline-flex h-11 items-center gap-1.5 rounded-full bg-accent px-4 text-sm font-bold text-white transition hover:bg-accent-strong active:scale-95" %>
  </header>

  <!-- これから支払う金額 -->
  <section aria-label="支払いのまとめ" class="flex flex-col gap-2.5 rounded-2xl bg-ink p-4 text-white">
    <span class="text-xs text-ink-faint">これから支払う金額</span>
    <span class="font-display text-[32px] leading-none font-bold">¥12,980</span>
    <div class="flex flex-wrap gap-2">
      <span class="rounded-lg bg-white/15 px-2.5 py-1 text-xs">未払い 3件</span>
      <span class="inline-flex items-center gap-1 rounded-lg bg-unpaid-bg px-2.5 py-1 text-xs font-bold text-unpaid">期限7日以内 1件</span>
    </div>
  </section>

  <!-- 絞り込み -->
  <nav aria-label="絞り込み" class="mt-3 flex gap-2">
    <button type="button" aria-pressed="true" class="h-10 rounded-full bg-ink px-4 text-[13px] font-bold text-white">すべて</button>
    <button type="button" aria-pressed="false" class="h-10 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">未払い</button>
    <button type="button" aria-pressed="false" class="h-10 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">支払済</button>
    <button type="button" aria-pressed="false" class="h-10 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">受取済</button>
  </nav>

  <!-- 予約一覧(状態はバッジの色で分ける) -->
  <ul class="mt-3 flex flex-col gap-2.5">
    <li class="flex flex-col gap-2 rounded-2xl border-[1.5px] border-unpaid bg-white p-3.5">
      <div class="flex items-center justify-between">
        <span class="rounded-md bg-unpaid-bg px-2 py-0.5 text-[11px] font-bold text-unpaid">未払い</span>
        <span class="text-xs font-bold text-unpaid">支払期限 10/8（あと4日）</span>
      </div>
      <span class="text-base font-bold text-ink">缶バッジ ランダムBOX</span>
      <div class="flex items-baseline justify-between">
        <span class="text-xs text-ink-soft">ソラ · 公式ストア · 発売 10月中旬</span>
        <span class="text-base font-bold text-ink">¥5,500</span>
      </div>
    </li>
    <li class="flex flex-col gap-2 rounded-2xl border border-line bg-white p-3.5">
      <div class="flex items-center justify-between">
        <span class="rounded-md bg-unpaid-bg px-2 py-0.5 text-[11px] font-bold text-unpaid">未払い</span>
        <span class="text-xs text-ink-soft">支払い：発送時</span>
      </div>
      <span class="text-base font-bold text-ink">アクリルスタンド</span>
      <div class="flex items-baseline justify-between">
        <span class="text-xs text-ink-soft">ミナト · 通販サイト · 発売 11月下旬</span>
        <span class="text-base font-bold text-ink">¥3,300<span class="text-[11px] font-normal text-ink-soft">（×2）</span></span>
      </div>
    </li>
    <li class="flex flex-col gap-2 rounded-2xl border border-line bg-white p-3.5">
      <div class="flex items-center justify-between">
        <span class="rounded-md bg-paid-bg px-2 py-0.5 text-[11px] font-bold text-paid">支払済</span>
        <span class="text-xs text-ink-soft">受取待ち</span>
      </div>
      <span class="text-base font-bold text-ink">ブロマイドセット</span>
      <div class="flex items-baseline justify-between">
        <span class="text-xs text-ink-soft">ツムギ · 公式ストア · 発売 10月下旬</span>
        <span class="text-base font-bold text-ink-soft">¥1,100</span>
      </div>
    </li>
  </ul>
</div>

<%= render "shared/bottom_nav", active: :reservations %>
