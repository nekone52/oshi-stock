<div class="mx-auto max-w-[430px] px-4 pb-28">

  <!-- ヘッダー(見出しと追加ボタン) -->
  <header class="flex items-center justify-between gap-3 pt-6 pb-3">
    <h1 class="font-display text-2xl font-bold text-ink">予約注文</h1>
    <%= link_to "＋ 予約を登録", new_reservation_path, class: "inline-flex h-11 shrink-0 items-center rounded-full bg-accent px-4 text-sm font-bold text-white transition hover:bg-accent-strong active:scale-95" %>
  </header>

  <!-- これから支払う金額 -->
  <section aria-label="支払いのまとめ" class="flex flex-col gap-2.5 rounded-2xl border border-line bg-white p-4 text-ink">
    <span class="text-[13px] text-ink-soft">これから支払う金額</span>
    <span class="font-display text-[32px] leading-none font-bold">¥12,100</span>
    <div class="flex flex-wrap gap-2">
      <span class="rounded-lg bg-bg px-2.5 py-1 text-xs text-ink">未払い 2件</span>
      <span class="inline-flex items-center gap-1 rounded-lg bg-unpaid-bg px-2.5 py-1 text-xs font-bold text-unpaid">期限7日以内 1件</span>
    </div>
  </section>

  <!-- 絞り込み -->
  <nav aria-label="絞り込み" class="mt-3 flex gap-2">
    <button type="button" aria-pressed="true" class="h-10 rounded-full bg-ink px-4 text-[13px] font-bold text-white">すべて</button>
    <button type="button" aria-pressed="false" class="h-10 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">未払い</button>
    <button type="button" aria-pressed="false" class="h-10 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">支払済</button>
    <button type="button" aria-pressed="false" class="h-10 rounded-full border border-line bg-white px-3.5 text-[13px] text-ink">届いた・未払い</button>
  </nav>

  <!-- 予約一覧(状態はバッジの色で分ける。支払い・受け取りはワンタップで切り替え) -->
  <ul class="mt-3 flex flex-col gap-2.5">
    <!-- 未払い・未着(支払期限が近い) -->
    <li class="flex flex-col gap-2 rounded-2xl border-[1.5px] border-unpaid bg-white p-3.5">
      <div class="flex items-center justify-between">
        <span class="rounded-md bg-unpaid-bg px-2 py-0.5 text-xs font-bold text-unpaid">未払い</span>
        <span class="text-[13px] font-bold text-unpaid">支払期限 10/8（あと4日）</span>
      </div>
      <span class="text-base font-bold text-ink">缶バッジ ランダムBOX</span>
      <div class="flex items-baseline justify-between">
        <span class="text-[13px] text-ink-soft">ソラ · 公式ストア · 発売 10月中旬</span>
        <span class="text-base font-bold text-ink">¥5,500</span>
      </div>
      <!-- メモ(書いてあるときだけ出す) -->
      <p class="flex items-start gap-1.5 rounded-lg bg-bg px-2.5 py-2 text-[13px] text-ink">
        <svg class="mt-px h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="M9 9h6M9 13h6M9 17h3"/></svg>
        <span class="line-clamp-2">送料+660円、特典付き</span>
      </p>
      <!-- ワンタップの切り替え -->
      <div class="grid grid-cols-2 gap-2">
        <button type="button" class="h-10 rounded-xl border border-paid bg-white text-[13px] font-bold text-paid">支払った</button>
        <button type="button" class="h-10 rounded-xl border border-accent bg-accent-soft text-[13px] font-bold text-accent-strong">届いた</button>
      </div>
    </li>

    <!-- 届いたけど未払い(支払うまでこの一覧に残す) -->
    <li class="flex flex-col gap-2 rounded-2xl border border-line bg-white p-3.5">
      <div class="flex items-center justify-between">
        <span class="rounded-md bg-unpaid-bg px-2 py-0.5 text-xs font-bold text-unpaid">届いた・未払い</span>
        <span class="text-[13px] text-ink-soft">支払期限 未定</span>
      </div>
      <span class="text-base font-bold text-ink">アクリルスタンド</span>
      <div class="flex items-baseline justify-between">
        <span class="text-[13px] text-ink-soft">ミナト · 通販サイト · 発売 11月下旬</span>
        <span class="text-base font-bold text-ink">¥3,300<span class="text-[11px] font-normal text-ink-soft">（×2）</span></span>
      </div>
      <p class="text-[13px] text-ink-soft">所持グッズにも入っています。支払うとこの一覧から消えます</p>
      <!-- ワンタップの切り替え(受け取り済みなので支払いだけ) -->
      <button type="button" class="h-10 rounded-xl border border-paid bg-white text-[13px] font-bold text-paid">支払った</button>
    </li>

    <!-- 支払い済み・未着 -->
    <li class="flex flex-col gap-2 rounded-2xl border border-line bg-white p-3.5">
      <div class="flex items-center justify-between">
        <span class="rounded-md bg-paid-bg px-2 py-0.5 text-xs font-bold text-paid">支払済</span>
        <span class="text-[13px] text-ink-soft">受取待ち</span>
      </div>
      <span class="text-base font-bold text-ink">ブロマイドセット</span>
      <div class="flex items-baseline justify-between">
        <span class="text-[13px] text-ink-soft">ツムギ · 公式ストア · 発売 10月下旬</span>
        <span class="text-base font-bold text-ink-soft">¥1,100</span>
      </div>
      <!-- メモ(書いてあるときだけ出す) -->
      <p class="flex items-start gap-1.5 rounded-lg bg-bg px-2.5 py-2 text-[13px] text-ink">
        <svg class="mt-px h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="M9 9h6M9 13h6M9 17h3"/></svg>
        <span class="line-clamp-2">保存用</span>
      </p>
      <!-- ワンタップの切り替え(届いたら所持グッズへ移動) -->
      <div class="grid grid-cols-2 gap-2">
        <button type="button" aria-pressed="true" class="h-10 rounded-xl bg-paid-bg text-[13px] font-bold text-paid">✓ 支払い済み</button>
        <button type="button" class="h-10 rounded-xl border border-accent bg-accent-soft text-[13px] font-bold text-accent-strong">届いた</button>
      </div>
    </li>
  </ul>
</div>

<%= render "shared/bottom_nav", active: :reservations %>
