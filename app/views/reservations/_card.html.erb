<%# 【予約カード1枚分(モック・見た目だけ)】発売月の中と、発売日待ちの箱の中で同じものを使う %>
<%# item:例のデータ1件 / colors:推しの色のクラス名 %>
<% soon = item[:state] == :unpaid && item[:due] && item[:due] <= 7 %>
<%# 支払い期限が7日以内のものは、枠の色を変えて目立たせる %>
<li class="flex flex-col gap-2.5 rounded-2xl bg-white p-3 <%= soon ? "border-[1.5px] border-unpaid" : "border border-line" %>">
  <div class="flex items-start gap-3">
    <!-- 商品画像(画像がないときは、推しの色の四角) -->
    <div class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl <%= colors[item[:chara]][:thumb] %>">
      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/></svg>
    </div>
    <div class="flex min-w-0 flex-1 flex-col gap-1">
      <!-- 状態のバッジと支払い期限 -->
      <div class="flex items-center justify-between gap-2">
        <% case item[:state] %>
        <% when :paid %>
          <span class="rounded-md bg-paid-bg px-2 py-0.5 text-[11px] font-bold text-paid">支払済</span>
          <span class="text-[13px] text-ink-soft">届くのを待っています</span>
        <% when :arrived %>
          <span class="rounded-md bg-unpaid-bg px-2 py-0.5 text-[11px] font-bold text-unpaid">届いた・未払い</span>
          <span class="text-[13px] text-ink-soft">支払期限 あと<%= item[:due] %>日</span>
        <% else %>
          <span class="rounded-md bg-unpaid-bg px-2 py-0.5 text-[11px] font-bold text-unpaid">未払い</span>
          <span class="text-[13px] <%= soon ? "font-bold text-unpaid" : "text-ink-soft" %>"><%= item[:due] ? "支払期限 あと#{item[:due]}日" : "支払期限 未定" %></span>
        <% end %>
      </div>
      <span class="text-[15px] font-bold break-words text-ink"><%= item[:name] %></span>
      <!-- 推しと、買ったお店 -->
      <span class="flex min-w-0 items-center gap-1 text-[13px] text-ink-soft">
        <span class="h-2.5 w-2.5 shrink-0 rounded-full <%= colors[item[:chara]][:dot] %>"></span>
        <span class="truncate"><%= item[:oshi] %> · <%= item[:shop] %></span>
      </span>
      <!-- 発売の時期(切れないように小さいタグ)と金額 -->
      <div class="flex items-center justify-between gap-2">
        <span class="inline-flex items-center gap-1 rounded-md bg-bg px-2 py-0.5 text-xs font-bold whitespace-nowrap text-ink">
          <svg class="h-3.5 w-3.5 text-ink-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 5h17v15h-17zM3.5 10h17M8 3v4M16 3v4"/></svg>
          <%= item[:release] %>
        </span>
        <span class="text-base font-bold whitespace-nowrap <%= item[:state] == :paid ? "text-ink-soft" : "text-ink" %>">
          <%= item[:price] %><% if item[:qty] > 1 %><span class="text-[11px] font-normal text-ink-soft">(×<%= item[:qty] %>)</span><% end %>
        </span>
      </div>
    </div>
  </div>
  <!-- メモ(書いてあるときだけ出す) -->
  <% if item[:memo] %>
    <p class="rounded-lg bg-bg px-2.5 py-1.5 text-[13px] text-ink"><%= item[:memo] %></p>
  <% end %>
  <!-- ワンタップの切り替え。2つとも白地に色の枠で同じ強さにして、色とアイコンで見分ける(押しまちがい防止) -->
  <div class="grid <%= item[:state] == :arrived ? "grid-cols-1" : "grid-cols-2" %> gap-2">
    <% if item[:state] == :paid %>
      <button type="button" aria-pressed="true" class="h-10 rounded-xl bg-paid-bg text-[13px] font-bold text-paid">✓ 支払い済み</button>
    <% else %>
      <button type="button" class="inline-flex h-10 items-center justify-center gap-1 rounded-xl border-[1.5px] border-paid bg-white text-[13px] font-bold text-paid">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 4l6 8 6-8M12 12v8M7.5 13h9M7.5 16.5h9"/></svg>支払った
      </button>
    <% end %>
    <% unless item[:state] == :arrived %>
      <button type="button" class="inline-flex h-10 items-center justify-center gap-1 rounded-xl border-[1.5px] border-accent bg-white text-[13px] font-bold text-accent-strong">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/></svg>届いた
      </button>
    <% end %>
  </div>
</li>
