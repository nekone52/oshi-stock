<%# ログアウトを本物にしたので、この画面は押せるようにする(ほかの項目はまだ見た目だけ) %>
<% content_for :interactive, true %>

<div class="mx-auto max-w-[430px] px-4 pb-28">

  <header class="pt-6 pb-3">
    <h1 class="font-display text-2xl font-bold text-ink">設定</h1>
  </header>

  <!-- アカウント -->
  <section aria-labelledby="account-heading" class="flex flex-col gap-2">
    <h2 id="account-heading" class="border-l-4 border-accent pl-2.5 font-display text-base font-bold text-ink">アカウント</h2>
    <div class="flex flex-col divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white">
      <button type="button" class="flex h-14 items-center justify-between px-4 text-left text-[15px] text-ink transition hover:bg-bg">
        メールアドレス
        <span class="text-sm text-ink-soft">変更 ›</span>
      </button>
      <button type="button" class="flex h-14 items-center justify-between px-4 text-left text-[15px] text-ink transition hover:bg-bg">
        パスワード
        <span class="text-sm text-ink-soft">変更 ›</span>
      </button>
    </div>
  </section>

  <!-- テーマの色(カラーピッカーで自由に選ぶ) -->
  <section aria-labelledby="theme-heading" class="mt-6 flex flex-col gap-2">
    <h2 id="theme-heading" class="border-l-4 border-chara-c pl-2.5 font-display text-base font-bold text-ink">テーマの色</h2>
    <div class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-4">
      <div class="flex items-center gap-3">
        <input id="theme-color" type="color" value="#E8577A" aria-label="テーマの色" class="h-12 w-14 shrink-0 cursor-pointer rounded-xl border border-line bg-white p-1">
        <!-- 選んだ色のプレビュー(グラデーション) -->
        <div class="h-12 flex-1 rounded-xl bg-gradient-to-r from-accent via-accent-soft to-white"></div>
      </div>
      <!-- ボタンの見え方(文字の色は、背景の明るさに合わせて自動で白か黒になる) -->
      <div class="flex items-center gap-3">
        <span class="shrink-0 whitespace-nowrap rounded-full bg-accent px-4 py-2 text-sm font-bold text-white">ボタンの見え方</span>
        <span class="text-xs text-ink-soft">文字の色は自動で読みやすい色になります</span>
      </div>
    </div>
  </section>

  <!-- その他 -->
  <section aria-labelledby="other-heading" class="mt-6 flex flex-col gap-2">
    <h2 id="other-heading" class="border-l-4 border-unpaid pl-2.5 font-display text-base font-bold text-ink">その他</h2>
    <div class="flex flex-col divide-y divide-line overflow-hidden rounded-2xl border border-line bg-white">
      <%= link_to terms_path, class: "flex h-14 items-center justify-between px-4 text-[15px] text-ink transition hover:bg-bg" do %>
        利用規約
        <span class="text-sm text-ink-soft">›</span>
      <% end %>
      <%= link_to privacy_path, class: "flex h-14 items-center justify-between px-4 text-[15px] text-ink transition hover:bg-bg" do %>
        プライバシーポリシー
        <span class="text-sm text-ink-soft">›</span>
      <% end %>
      <!-- ログアウト(DELETE /session → sessions#destroy) -->
      <%= button_to session_path, method: :delete, form_class: "contents", class: "flex h-14 w-full items-center justify-between px-4 text-left text-[15px] text-ink transition hover:bg-bg" do %>
        ログアウト
        <span class="text-sm text-ink-soft">›</span>
      <% end %>
      <!-- 退会(アカウント削除) -->
      <%= link_to withdraw_path, class: "flex h-14 items-center justify-between px-4 text-[15px] font-bold text-danger transition hover:bg-bg" do %>
        退会する
        <span class="text-sm">›</span>
      <% end %>
    </div>
  </section>
</div>

<%= render "shared/bottom_nav", active: :settings %>
