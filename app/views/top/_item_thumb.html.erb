<% color = item.character.display_color %>
<%# shop_tag: :corner = 左上にお店のタグ / :band = 写真の下にお店の帯(渡さないときは出さない)/ badge: 左上にならべる状態のバッジ %>
<% shop_tag = local_assigns[:shop_tag] %>
<% badge = local_assigns[:badge] %>
<% show_shop = shop_tag == :corner && item.show_shop_tag? %>
<% show_band = shop_tag == :band && item.show_shop_tag? %>
<div style="background-color: color-mix(in srgb, <%= color %> 18%, white); color: <%= color %>" class="relative flex items-center justify-center overflow-hidden <%= css %>">
  <% if item.image.attached? %>
    <%= image_tag item.image.variant(:display), alt: item.name, draggable: false, class: "h-full w-full object-cover select-none [-webkit-touch-callout:none]" %>
  <% else %>
    <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="m20.5 16-5-5-8 8.5"/></svg>
  <% end %>
  <%# 左上の箱:状態のバッジ → お店のタグ の順に縦にならべる。長いお店の名前は「…」で切る %>
  <% if badge || show_shop %>
    <div class="absolute top-2 right-2 left-2 flex flex-col items-start gap-1">
      <% if badge %>
        <span class="rounded-full bg-white px-2 py-0.5 text-[10px] font-bold text-ink shadow-sm"><%= badge %></span>
      <% end %>
      <% if show_shop %>
        <span class="max-w-full truncate rounded-full bg-white px-2 py-0.5 text-[10px] font-bold text-ink shadow-sm"><%= item.shop_name %></span>
      <% end %>
    </div>
  <% end %>
  <%# 下の帯:写真の下のはしに白い帯でお店の名前。小さい写真なので、長い名前は「…」で切る %>
  <% if show_band %>
    <span class="absolute inset-x-0 bottom-0 truncate bg-white/90 px-1 py-px text-center text-[9px] font-bold text-ink"><%= item.shop_name %></span>
  <% end %>
</div>
