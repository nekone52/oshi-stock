<%# この画面は本物の画面なので、押せない設定(inert)を外す %>
<% content_for :interactive, true %>

  <div class="mx-auto max-w-[430px] px-4 pb-28">

    <header class="sticky top-0 z-10 flex items-center justify-between bg-bg pb-2 pt-4">
      <%= image_tag "logo.png", alt: "推しストック", class: "w-[9.5rem] h-auto" %>
      <!-- 設定 -->
      <%= link_to settings_path, class: "inline-flex items-center gap-2 rounded-full border-2 border-ink bg-white px-4 py-2.5 text-sm font-bold text-ink transition hover:bg-bg active:scale-95" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        設定
      <% end %>
    </header>

    <!-- 推しがまだいないとき(初めてログインした直後) -->
    <section class="mt-6 flex flex-col items-center gap-3 rounded-2xl bg-white px-5 py-8 text-center">
      <div class="flex h-20 w-20 items-center justify-center rounded-full border-2 border-dashed border-line text-ink-soft">
        <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      </div>
      <h1 class="font-display text-xl font-bold text-ink">まだ推しがいません</h1>
      <p class="text-sm text-ink-soft">まずは推し(キャラ)を登録しよう！</p>
      <%= link_to "＋ 推しを登録する", new_oshi_path, class: "mt-2 flex h-12 w-full items-center justify-center rounded-2xl bg-accent font-display text-base font-bold text-on-accent transition hover:bg-accent-strong active:scale-95" %>
    </section>

    <!-- 3つのセクション(まだ空) -->
    <section class="mt-6 flex flex-col gap-2.5">
      <% [ [ "ほしい物リスト", "border-chara-a" ], [ "予約注文中", "border-unpaid" ], [ "所持グッズ", "border-chara-b" ] ].each do |title, border| %>
        <div class="flex items-center justify-between rounded-2xl bg-white px-4 py-3">
          <h2 class="border-l-4 <%= border %> pl-2.5 font-display text-[1.05rem] font-bold text-ink"><%= title %></h2>
          <span class="text-[13px] text-ink-soft">まだありません</span>
        </div>
      <% end %>
    </section>

  </div>
