  <div class="mx-auto max-w-[430px] px-4 pb-10">

    <header class="sticky top-0 z-10 flex items-center justify-between bg-bg pb-2 pt-4">
      <%= image_tag "logo.png", alt: "推しストック", class: "w-[9.5rem] h-auto" %>
      <!-- 設定 -->
      <button class="inline-flex items-center gap-2 rounded-full border-2 border-ink bg-white px-4 py-2.5 text-sm font-bold text-ink transition hover:bg-bg active:scale-95">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        設定
      </button>
    </header>
    <p class="pb-2 text-[11px] text-ink-faint">サンプルデータで表示しています</p>

    <!-- これから支払う金額のまとめ(予約注文へ) -->
    <%= link_to reservations_path, class: "mt-2 flex items-center justify-between rounded-2xl border border-line bg-white px-4 py-3" do %>
      <div class="flex flex-col">
        <span class="text-xs text-ink-soft">これから支払う金額</span>
        <span class="font-display text-2xl font-bold text-ink">¥12,100</span>
      </div>
      <div class="flex flex-col items-end gap-1">
        <span class="rounded-lg bg-bg px-2 py-0.5 text-xs text-ink">未払い 2件</span>
        <span class="rounded-lg bg-unpaid-bg px-2 py-0.5 text-xs font-bold text-unpaid">期限7日以内 1件</span>
      </div>
    <% end %>

    <!-- 推しキャラ(囲み) -->
    <div class="mt-2 rounded-2xl bg-white px-3 pt-3 pb-1">

    <!-- 推しキャラ一覧(見出し) -->
    <div class="flex items-center justify-between border-l-4 border-unpaid pl-2.5">
      <h2 class="font-display text-xl font-bold text-unpaid">推しキャラ</h2>
      <span class="inline-flex items-center gap-1 rounded-full border-2 border-ink bg-white px-3 py-1 text-xs font-bold">推しキャラ一覧 <span aria-hidden="true">→</span></span>
    </div>

    <!-- キャラ絞り込み -->
    <nav class="-mx-4 flex gap-3.5 overflow-x-auto px-4 pb-4 pt-1">
      <button class="flex shrink-0 flex-col items-center gap-1.5">
        <span class="flex h-16 w-16 items-center justify-center rounded-full bg-[#64748B] font-display text-lg font-bold text-white ring-4 ring-[#64748B]/20">全</span>
        <span class="text-[11px] font-bold text-ink">すべて</span>
      </button>
      <button class="flex shrink-0 flex-col items-center gap-1.5">
        <span class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-transparent bg-chara-a-soft font-display text-lg font-bold text-chara-a">陽</span>
        <span class="text-[11px] text-ink-soft">ヒナタ</span>
      </button>
      <button class="flex shrink-0 flex-col items-center gap-1.5">
        <span class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-transparent bg-chara-b-soft font-display text-lg font-bold text-chara-b">蒼</span>
        <span class="text-[11px] text-ink-soft">アオイ</span>
      </button>
      <button class="flex shrink-0 flex-col items-center gap-1.5">
        <span class="flex h-16 w-16 items-center justify-center rounded-full border-2 border-transparent bg-chara-c-soft font-display text-lg font-bold text-chara-c">凛</span>
        <span class="text-[11px] text-ink-soft">リン</span>
      </button>
    </nav>

    </div>

    <!-- 検索 -->
    <div class="relative mt-2 mb-4">
      <svg class="pointer-events-none absolute top-1/2 left-4 h-4 w-4 -translate-y-1/2 text-ink-faint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path stroke-linecap="round" d="M20 20l-3.5-3.5" />
      </svg>
      <input type="search" placeholder="グッズ名で検索..." class="w-full rounded-full border border-line bg-white py-2.5 pr-4 pl-11 text-base placeholder:text-ink-faint focus:border-accent focus:outline-none">
    </div>

    <!-- ほしい物リスト -->
    <section class="pt-2">
      <div class="mb-2.5 flex items-baseline justify-between">
        <div class="flex flex-col gap-0.5 border-l-4 border-chara-a pl-2.5">
          <h2 class="font-display text-[1.05rem] font-bold">ほしい物リスト <span class="ml-1 rounded-full bg-chara-a-soft px-2 py-0.5 font-body text-[11px] font-bold text-chara-a">3</span></h2>
          <p class="text-[11px] text-ink-soft">まだ買っていないもの</p>
        </div>
        <span class="inline-flex items-center gap-1 rounded-full border-2 border-chara-a text-chara-a bg-white px-3 py-1 text-xs font-bold">すべて見る <span aria-hidden="true">→</span></span>
      </div>
      <div class="-mx-4 flex gap-3 overflow-x-auto px-4 pb-1">
        <article class="w-[132px] shrink-0 overflow-hidden rounded-2xl bg-white shadow-sm">
          <div class="flex h-20 items-center justify-center bg-chara-a-soft text-chara-a">
            <span class="h-8 w-8 rounded-full border-2 border-current"></span>
          </div>
          <div class="p-2">
            <p class="mb-1 line-clamp-2 text-[13px] font-medium leading-snug">缶バッジ第3弾</p>
            <p class="flex items-center gap-1 text-[11px] text-ink-soft"><span class="h-2 w-2 rounded-full bg-chara-a"></span>ヒナタ</p>
            <span class="mt-1 inline-block rounded-full border border-line bg-bg px-2 py-0.5 text-[10px] font-bold text-ink-faint">URLのみ</span>
          </div>
        </article>
        <article class="w-[132px] shrink-0 overflow-hidden rounded-2xl bg-white shadow-sm">
          <div class="flex h-20 items-center justify-center bg-chara-b-soft text-chara-b">
            <span class="h-8 w-8 rounded-md border-2 border-current"></span>
          </div>
          <div class="p-2">
            <p class="mb-1 line-clamp-2 text-[13px] font-medium leading-snug">ライブTシャツ2026</p>
            <p class="flex items-center gap-1 text-[11px] text-ink-soft"><span class="h-2 w-2 rounded-full bg-chara-b"></span>アオイ</p>
            <span class="mt-1 inline-block rounded-full border border-line bg-bg px-2 py-0.5 text-[10px] font-bold text-ink-faint">URLのみ</span>
          </div>
        </article>
        <article class="w-[132px] shrink-0 overflow-hidden rounded-2xl bg-white shadow-sm">
          <div class="flex h-20 items-center justify-center bg-chara-c-soft text-chara-c">
            <span class="h-10 w-7 rounded-md border-2 border-current"></span>
          </div>
          <div class="p-2">
            <p class="mb-1 line-clamp-2 text-[13px] font-medium leading-snug">海辺verアクリルスタンド</p>
            <p class="flex items-center gap-1 text-[11px] text-ink-soft"><span class="h-2 w-2 rounded-full bg-chara-c"></span>リン</p>
          </div>
        </article>
      </div>
    </section>

    <!-- 予約注文中 -->
    <section class="pt-6">
      <div class="mb-2.5 flex items-baseline justify-between">
        <div class="flex flex-col gap-0.5 border-l-4 border-unpaid pl-2.5">
          <h2 class="font-display text-[1.05rem] font-bold">予約注文中 <span class="ml-1 rounded-full bg-unpaid-bg px-2 py-0.5 font-body text-[11px] font-bold text-unpaid">3</span></h2>
          <p class="text-[11px] text-ink-soft">注文済み・支払いや到着を待っているもの</p>
        </div>
        <span class="inline-flex items-center gap-1 rounded-full border-2 border-unpaid text-unpaid bg-white px-3 py-1 text-xs font-bold">すべて見る <span aria-hidden="true">→</span></span>
      </div>
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center gap-3 rounded-2xl bg-white p-2.5 shadow-sm">
          <div class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-xl bg-chara-a-soft text-chara-a"><span class="h-5 w-3.5 rounded-sm border-2 border-current"></span></div>
          <div class="min-w-0 flex-1">
            <p class="mb-1 truncate text-[14px] font-medium">夏祭りアクリルスタンド</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="flex items-center gap-1 text-[11px] text-ink-soft"><span class="h-2 w-2 rounded-full bg-chara-a"></span>ヒナタ</span>
              <span class="rounded-full bg-unpaid-bg px-2 py-0.5 text-[10px] font-bold text-unpaid">未払い</span>
              <span class="text-[11px] tabular-nums text-ink-soft">10月上旬予定</span>
            </div>
          </div>
          <button class="shrink-0 whitespace-nowrap rounded-full border border-accent bg-accent-soft px-3 py-2 text-xs font-bold text-accent-strong">届いた</button>
        </div>
        <div class="flex items-center gap-3 rounded-2xl bg-white p-2.5 shadow-sm">
          <div class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-xl bg-chara-c-soft text-chara-c"><span class="h-4 w-4 rounded-full border-2 border-current"></span></div>
          <div class="min-w-0 flex-1">
            <p class="mb-1 truncate text-[14px] font-medium">ぬいぐるみ Mサイズ</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="flex items-center gap-1 text-[11px] text-ink-soft"><span class="h-2 w-2 rounded-full bg-chara-c"></span>リン</span>
              <span class="rounded-full bg-paid-bg px-2 py-0.5 text-[10px] font-bold text-paid">支払い完了</span>
              <span class="text-[11px] tabular-nums text-ink-soft">11月中旬予定</span>
            </div>
          </div>
          <button class="shrink-0 whitespace-nowrap rounded-full border border-accent bg-accent-soft px-3 py-2 text-xs font-bold text-accent-strong">届いた</button>
        </div>
        <div class="flex items-center gap-3 rounded-2xl bg-white p-2.5 shadow-sm">
          <div class="flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-xl bg-chara-b-soft text-chara-b"><span class="h-4 w-4 rounded-sm border-2 border-current"></span></div>
          <div class="min-w-0 flex-1">
            <p class="mb-1 truncate text-[14px] font-medium">トレーディングカードファイル</p>
            <div class="flex flex-wrap items-center gap-2">
              <span class="flex items-center gap-1 text-[11px] text-ink-soft"><span class="h-2 w-2 rounded-full bg-chara-b"></span>アオイ</span>
              <span class="rounded-full bg-unpaid-bg px-2 py-0.5 text-[10px] font-bold text-unpaid">未払い</span>
              <span class="text-[11px] tabular-nums text-ink-soft">発送日未定</span>
            </div>
          </div>
          <button class="shrink-0 whitespace-nowrap rounded-full border border-accent bg-accent-soft px-3 py-2 text-xs font-bold text-accent-strong">届いた</button>
        </div>
      </div>
    </section>

    <!-- 所持グッズ -->
    <section class="pt-6">
      <div class="mb-2.5 flex items-baseline justify-between">
        <div class="flex flex-col gap-0.5 border-l-4 border-chara-b pl-2.5">
          <h2 class="font-display text-[1.05rem] font-bold">所持グッズ <span class="ml-1 rounded-full bg-chara-b-soft px-2 py-0.5 font-body text-[11px] font-bold text-chara-b">4</span></h2>
          <p class="text-[11px] text-ink-soft">手元にあるもの</p>
        </div>
        <span class="inline-flex items-center gap-1 rounded-full border-2 border-chara-b text-chara-b bg-white px-3 py-1 text-xs font-bold">すべて見る <span aria-hidden="true">→</span></span>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
          <div class="relative flex aspect-[1.15] items-center justify-center bg-chara-a-soft text-chara-a">
            <span class="h-8 w-8 rounded-full border-2 border-current"></span>
            <span class="absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-chara-a font-display text-[10px] font-bold text-white">陽</span>
          </div>
          <p class="p-2.5 text-[13px] font-medium leading-snug">缶バッジ vol.1</p>
        </article>
        <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
          <div class="relative flex aspect-[1.15] items-center justify-center bg-chara-c-soft text-chara-c">
            <span class="h-10 w-7 rounded-md border-2 border-current"></span>
            <span class="absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-chara-c font-display text-[10px] font-bold text-white">凛</span>
          </div>
          <p class="p-2.5 text-[13px] font-medium leading-snug">学園verアクリルスタンド</p>
        </article>
        <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
          <div class="relative flex aspect-[1.15] items-center justify-center bg-chara-b-soft text-chara-b">
            <span class="h-8 w-8 rounded-md border-2 border-current"></span>
            <span class="absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-chara-b font-display text-[10px] font-bold text-white">蒼</span>
          </div>
          <p class="p-2.5 text-[13px] font-medium leading-snug">マフラータオル</p>
        </article>
        <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
          <div class="relative flex aspect-[1.15] items-center justify-center bg-chara-a-soft text-chara-a">
            <span class="h-8 w-6 rounded-md border-2 border-current"></span>
            <span class="absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-chara-a font-display text-[10px] font-bold text-white">陽</span>
          </div>
          <p class="p-2.5 text-[13px] font-medium leading-snug">ぬい服セット</p>
        </article>
      </div>
    </section>

    <footer class="mt-6 border-t border-dashed border-line pt-4 text-[11px] leading-relaxed text-ink-faint">
      上のアイコンでキャラを絞り込めます(未選択なら全キャラ表示)。「届いた」を押すと、支払い状況に関わらず所持グッズへ自動で移動します。
    </footer>

  </div>
